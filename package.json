{
  "name": "alh-science-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "UV_THREADPOOL_SIZE=1 next build --webpack",
    "build:measure": "node scripts/measure-build-processes.mjs",
    "start": "node scripts/start-standalone.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm check:links && pnpm build && pnpm check:seo && pnpm check:performance",
    "check:links": "node scripts/check-internal-links.mjs",
    "check:seo": "node scripts/check-seo-routes.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:performance": "node scripts/check-performance-budget.mjs",
    "check:a11y": "node scripts/check-accessibility.mjs",
    "verify:hostinger": "node scripts/verify-hostinger-build-safety.mjs",
    "seo:audit": "node scripts/seo/audit-pages.mjs",
    "seo:audit:live": "node scripts/seo/audit-live-site.mjs"
  },
  "dependencies": {
    "next": "16.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@tailwindcss/postcss": "4.3.1",
    "@types/node": "20.19.43",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.0",
    "playwright-core": "^1.61.1",
    "tailwindcss": "4.3.1",
    "typescript": "5.9.3",
    "vitest": "^4.1.9"
  },
  "description": "Interactive science learning, laboratory calculations, experiment planning, and report support from ALH Science Hub.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=11.13.1 <12"
  }
}
