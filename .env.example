NEXT_PUBLIC_SITE_URL=https://sciencecalchub.com
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ==========================================
# AI TUTOR — SERVER-SIDE CONFIGURATION
# ==========================================
# These are examples only. Never commit real credentials.
# Do not prefix private variables with NEXT_PUBLIC_.

# Cloud AI provider
AI_PROVIDER=cloud
AI_CLOUD_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Local development may use "off".
# Production ignores this bypass and enforces rate limiting.
AI_RATE_LIMIT_MODE=

# Required for production rate limiting (Upstash Redis REST).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Generate a unique cryptographically random secret.
# Minimum 32 characters. Never reuse an API key.
AI_RATE_LIMIT_SECRET=

# Production client identification currently requires Vercel.
# VERCEL is provided by the hosting environment.
# Do not manually set VERCEL=1 on untrusted infrastructure.
